# Plantilla de variables de entorno. Copiar a .env (que NO se sube al repositorio).
# En desarrollo local los valores por defecto ya funcionan.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siga_db
DB_USER=root
DB_PASSWORD=1234

# --- Keycloak / OAuth2 ---
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/siga
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/siga/protocol/openid-connect/certs
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# --- CORS (origenes del frontend, separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
