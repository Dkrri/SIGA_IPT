# Copy this file to .env and change the passwords/secrets before deploying.
# The .env file is ignored by Git.

# ------------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------------
# URL used by the browser to reach the application (Nginx).
PUBLIC_APP_URL=http://localhost
# URL used by the browser to reach Keycloak.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Host ports. Change them if they are already in use.
HTTP_PORT=80
KEYCLOAK_PORT=8081

# ------------------------------------------------------------------
# Images published by CI
# ------------------------------------------------------------------
BACKEND_IMAGE=dkrii/siga-backend:latest
FRONTEND_IMAGE=dkrii/siga-frontend:latest

# ------------------------------------------------------------------
# MySQL application database
# ------------------------------------------------------------------
DB_ROOT_PASSWORD=change-me-root
DB_NAME=siga_db
DB_USER=siga
DB_PASSWORD=change-me-app

# ------------------------------------------------------------------
# Keycloak database
# ------------------------------------------------------------------
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# ------------------------------------------------------------------
# Keycloak bootstrap administrator (Keycloak console, realm master)
# ------------------------------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-keycloak-admin

# Secret of the Keycloak service account used by the backend
# to provision student/teacher users. It must match the client secret
# configured in the siga realm.
KEYCLOAK_ADMIN_CLIENT_SECRET=siga-admin-secret

# ------------------------------------------------------------------
# Frontend build-time variables (used by CI / manual docker build)
# Vite embeds these values into the static bundle.
# ------------------------------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=siga
VITE_KEYCLOAK_CLIENT_ID=siga-frontend
